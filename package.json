{
  "name": "discord-music-bot",
  "version": "3.12.1",
  "description": "Discord music bot with Spotify support",
  "main": "index.js",
  "scripts": {
    "start": "node --max-old-space-size=4096 --expose-gc index.js",
    "deploy": "node deploy-commands.js",
    "test": "node --test test/*.test.js",
    "validate": "node scripts/validate-commands.js",
    "postinstall": "node scripts/patch-ytsr.js",
    "install-native": "node scripts/install-native.js",
    "db-shell": "node scripts/db-shell.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@distube/soundcloud": "^2.0.4",
    "@distube/spotify": "^2.0.2",
    "@distube/youtube": "^1.1.0",
    "@distube/yt-dlp": "^2.0.1",
    "@distube/ytdl-core": "^5.2.1",
    "discord.js": "^14.28.1",
    "distube": "^5.2.3",
    "dotenv": "^18.0.10",
    "ffmpeg-static": "^5.3.0",
    "genius-lyrics": "^4.4.7",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.1.1",
    "tweetnacl": "^1.0.3",
    "ws": "^8.22.2"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.11.0",
    "@noble/ciphers": "^2.4.0",
    "@stablelib/xchacha20poly1305": "^2.0.0",
    "better-sqlite3": "^13.0.3",
    "sodium-native": "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
