# Dependencies
node_modules/
package-lock.json
yarn.lock

# Secrets — never commit
.env
.env.local
.env.*.local
# YouTube cookies dropped for import (only its README is kept)
cookies/*
!cookies/README.md

# Runtime data (user-specific — favorites, history, configs, session state)
data/
gui/hotkeys.json

# Vencord plugin build output
vencord-plugin/dist/

# Logs / OS / IDE
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Backups created by /backup command
maowcore-backup-*.json

# MaowCore Portable build output
desktop/node_modules/
desktop/dist/
desktop/build/
