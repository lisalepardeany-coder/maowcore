# ===== Required =====
# https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=your_discord_bot_token_here
# https://discord.com/developers/applications → your app → General Information → Application ID
CLIENT_ID=your_discord_application_client_id_here

# ===== Optional =====
# Set a guild ID to deploy slash commands instantly to that server.
# Leave empty for global deploy (up to 1 hour to propagate).
GUILD_ID=

# Spotify API — required for /play <spotify-url> and audio-features (BPM/key/energy)
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Genius API token — required for /lyrics. Get one at https://genius.com/api-clients
GENIUS_TOKEN=

# Twitch go-live notifications (/livenotify twitch) — create a free app at
# https://dev.twitch.tv/console/apps (OAuth redirect can be http://localhost).
# YouTube notifications need NO key (they use the public RSS feed).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Discord OAuth — required for dashboard sign-in (/api/auth). Same app as above.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# First dashboard owner (your Discord user ID) + cross-server /announceupdate
OWNER_USER_ID=

# Dashboard / WebSocket server settings
# Default 127.0.0.1 binds locally only. Set 0.0.0.0 to expose to your LAN
# (useful for phone access or Docker). DO NOT expose publicly without auth.
CONTROL_HOST=127.0.0.1
CONTROL_PORT=8765

# Multi-bot setup — sets the name shown in modlog attribution ("via <name>")
BOT_INSTANCE_NAME=MaowCore
